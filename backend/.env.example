# Environment variables for Flask backend

# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py
DEBUG=False

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=code_smell_detection

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Model Configuration
MODEL_PATH=../ml_pipeline/saved_models/hybrid_code_smell_model.pt
DEVICE=cuda  # or 'cpu'

# Logging
LOG_LEVEL=INFO
